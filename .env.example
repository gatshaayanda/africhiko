# Africhiko Firebase web app
NEXT_PUBLIC_BASE_URL=https://africhiko.vercel.app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=africhiko.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=africhiko
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# UploadThing token for customer enquiry image/PDF references.
UPLOADTHING_TOKEN=

# Server-only Firebase Admin service account JSON, if a trusted server workflow is added.
# Never commit the actual secret or a production .env file.
FIREBASE_ADMIN_KEY=
