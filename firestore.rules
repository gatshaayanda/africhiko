rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in ['owner', 'staff'];
    }

    function validEnquiryCreate() {
      return signedIn()
        && request.resource.data.keys().hasAll([
          'customerId', 'name', 'phone', 'email', 'location', 'intendedUse',
          'dimensions', 'materials', 'notes', 'quantity', 'services',
          'status', 'createdAt', 'createdAtServer'
        ])
        && request.resource.data.keys().hasOnly([
          'customerId', 'name', 'phone', 'email', 'location', 'intendedUse',
          'dimensions', 'materials', 'notes', 'quantity', 'services',
          'attachmentUrl', 'status', 'createdAt', 'createdAtServer'
        ])
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 7
        && request.resource.data.phone.size() <= 40
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.location is string
        && request.resource.data.location.size() > 0
        && request.resource.data.location.size() <= 300
        && request.resource.data.intendedUse is string
        && request.resource.data.intendedUse.size() > 0
        && request.resource.data.intendedUse.size() <= 3000
        && request.resource.data.dimensions is string
        && request.resource.data.dimensions.size() <= 3000
        && request.resource.data.materials is string
        && request.resource.data.materials.size() <= 2000
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 5000
        && request.resource.data.quantity is int
        && request.resource.data.quantity >= 1
        && request.resource.data.quantity <= 10000
        && request.resource.data.services is list
        && request.resource.data.services.size() <= 20
        && (!request.resource.data.keys().hasAny(['attachmentUrl'])
          || (request.resource.data.attachmentUrl is string
            && request.resource.data.attachmentUrl.size() <= 2048))
        && request.resource.data.status == 'New'
        && request.resource.data.createdAt is string
        && request.resource.data.createdAtServer == request.time;
    }

    function validEnquiryUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'staffNotes', 'followUpAt', 'updatedAt'])
        && request.resource.data.status in [
          'New', 'Reviewing', 'Quotation in progress', 'Quotation sent',
          'Accepted', 'Declined', 'Completed'
        ]
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['staffNotes'])
          || (request.resource.data.staffNotes is string
            && request.resource.data.staffNotes.size() <= 5000))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['followUpAt'])
          || (request.resource.data.followUpAt is string
            && request.resource.data.followUpAt.size() <= 20))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['updatedAt'])
          || request.resource.data.updatedAt is string);
    }

    match /admins/{uid} {
      // A user may read their own role document; only trusted setup may write it.
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update, delete: if false;
    }

    match /services/{serviceId} {
      // The public catalogue is not private; staff-only writes protect its integrity.
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /workFeed/{workId} {
      allow read: if resource.data.active == true || isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasAll(['caption', 'category', 'mediaUrl', 'mediaType', 'active'])
        && request.resource.data.caption is string
        && request.resource.data.caption.size() > 0
        && request.resource.data.caption.size() <= 300
        && request.resource.data.category is string
        && request.resource.data.mediaUrl is string
        && request.resource.data.mediaUrl.size() <= 2048
        && request.resource.data.mediaType in ['image', 'video', 'pdf']
        && request.resource.data.active is bool;
      allow delete: if isAdmin();
    }

    match /announcements/{announcementId} {
      allow read: if resource.data.active == true || isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasAll(['title', 'message', 'active'])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 1000
        && request.resource.data.active is bool;
      allow delete: if isAdmin();
    }

    match /workInterests/{interestId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['workId', 'category', 'customerId', 'createdAt'])
        && request.resource.data.keys().hasOnly(['workId', 'category', 'customerId', 'createdAt'])
        && request.resource.data.customerId == request.auth.uid
        && interestId == request.resource.data.workId + '_' + request.auth.uid
        && exists(/databases/$(database)/documents/workFeed/$(request.resource.data.workId))
        && get(/databases/$(database)/documents/workFeed/$(request.resource.data.workId)).data.active == true;
      allow read: if isAdmin() || (signedIn() && resource.data.customerId == request.auth.uid);
      allow update, delete: if false;
    }

    match /enquiries/{enquiryId} {
      // Guests use Firebase anonymous auth, so each enquiry is bound to its own UID.
      allow create: if validEnquiryCreate();
      allow read: if isAdmin()
        || (signedIn() && resource.data.customerId == request.auth.uid);
      allow update: if isAdmin() && validEnquiryUpdate();
      allow delete: if false;

      match /messages/{messageId} {
        function canAccessEnquiry() {
          return isAdmin() || (signedIn()
            && get(/databases/$(database)/documents/enquiries/$(enquiryId)).data.customerId == request.auth.uid);
        }
        allow read: if canAccessEnquiry();
        allow create: if signedIn()
          && request.resource.data.keys().hasAll(['senderUid', 'senderRole', 'body', 'createdAt', 'createdAtServer'])
          && request.resource.data.keys().hasOnly(['senderUid', 'senderRole', 'body', 'createdAt', 'createdAtServer'])
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.body is string
          && request.resource.data.body.size() > 0
          && request.resource.data.body.size() <= 2000
          && request.resource.data.createdAt is string
          && request.resource.data.createdAtServer == request.time
          && ((request.resource.data.senderRole == 'admin' && isAdmin())
            || (request.resource.data.senderRole == 'customer' && signedIn()
              && get(/databases/$(database)/documents/enquiries/$(enquiryId)).data.customerId == request.auth.uid));
        allow update, delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
