rules_version = '2';
service firebase.storage {
 match /b/{bucket}/o {
  function signedIn(){return request.auth != null;}
  function isAdmin(){return signedIn() && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid)) && firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.role in ['owner','staff','Owner','Staff'];}
  match /projectReferences/{uid}/{fileName}{
   allow create,update:if signedIn() && request.auth.uid == uid && request.resource.size < 4 * 1024 * 1024 && (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf');
   allow read:if isAdmin() || (signedIn() && request.auth.uid == uid);
   allow delete:if isAdmin() || (signedIn() && request.auth.uid == uid);
  }
  match /{allPaths=**}{allow read,write:if false;}
 }
}
